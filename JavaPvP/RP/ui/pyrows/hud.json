{
  "namespace": "pyrows",
  "status_feed": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "property_bag": {
      "#held_text": ""
    },
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_name": "#hud_title_text_string",
        "binding_name_override": "#held_text",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#hud_title_text_string = #held_text) and not ((#hud_title_text_string - 'PYROWS') = #hud_title_text_string))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.7s' * #held_text - ('%.6s' * #held_text)) - '0')",
        "target_property_name": "#feet_present"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.9s' * #held_text - ('%.7s' * #held_text)) - '0')",
        "target_property_name": "#feet_material"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.14s' * #held_text - ('%.9s' * #held_text)) - '0')",
        "target_property_name": "#feet_cur"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.19s' * #held_text - ('%.14s' * #held_text)) - '0')",
        "target_property_name": "#feet_max"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.20s' * #held_text - ('%.19s' * #held_text)) - '0')",
        "target_property_name": "#legs_present"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.22s' * #held_text - ('%.20s' * #held_text)) - '0')",
        "target_property_name": "#legs_material"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.27s' * #held_text - ('%.22s' * #held_text)) - '0')",
        "target_property_name": "#legs_cur"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.32s' * #held_text - ('%.27s' * #held_text)) - '0')",
        "target_property_name": "#legs_max"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.33s' * #held_text - ('%.32s' * #held_text)) - '0')",
        "target_property_name": "#chest_present"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.35s' * #held_text - ('%.33s' * #held_text)) - '0')",
        "target_property_name": "#chest_material"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.40s' * #held_text - ('%.35s' * #held_text)) - '0')",
        "target_property_name": "#chest_cur"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.45s' * #held_text - ('%.40s' * #held_text)) - '0')",
        "target_property_name": "#chest_max"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.46s' * #held_text - ('%.45s' * #held_text)) - '0')",
        "target_property_name": "#head_present"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.48s' * #held_text - ('%.46s' * #held_text)) - '0')",
        "target_property_name": "#head_material"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.53s' * #held_text - ('%.48s' * #held_text)) - '0')",
        "target_property_name": "#head_cur"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.58s' * #held_text - ('%.53s' * #held_text)) - '0')",
        "target_property_name": "#head_max"
      }
    ]
