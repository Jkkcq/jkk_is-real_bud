{
  "format_version": "1.8.0",
  "animations": {
    "animation.player.move.arms": {
      "loop": true,
      "bones": {
        "leftarm": {
          "rotation": [
            "(variable.tcos0 * ((query.is_sprinting && !query.is_in_water && !query.is_swimming && !query.is_riding && !query.is_gliding && !variable.is_paperdoll) ? math.clamp((0.90 + 0.10 * math.pow(math.clamp((query.modified_move_speed - 0.90) / 0.10, 0.0, 1.0), 2.0) * (2.0 - math.clamp((query.modified_move_speed - 0.90) / 0.10, 0.0, 1.0)) + math.max(query.modified_move_speed - 1.0, 0.0)) / math.max(query.modified_move_speed, 0.12), 0.95, 3.2) : 1.0))",
            0.0,
            0.0
          ]
        },
        "rightarm": {
          "rotation": [
            "-(variable.tcos0 * ((query.is_sprinting && !query.is_in_water && !query.is_swimming && !query.is_riding && !query.is_gliding && !variable.is_paperdoll) ? math.clamp((0.90 + 0.10 * math.pow(math.clamp((query.modified_move_speed - 0.90) / 0.10, 0.0, 1.0), 2.0) * (2.0 - math.clamp((query.modified_move_speed - 0.90) / 0.10, 0.0, 1.0)) + math.max(query.modified_move_speed - 1.0, 0.0)) / math.max(query.modified_move_speed, 0.12), 0.95, 3.2) : 1.0))",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.player.move.legs": {
      "loop": true,
      "bones": {
        "leftleg": {
          "rotation": [
            "(variable.tcos0 * ((query.is_sprinting && !query.is_in_water && !query.is_swimming && !query.is_riding && !query.is_gliding && !variable.is_paperdoll) ? math.clamp((0.90 + 0.10 * math.pow(math.clamp((query.modified_move_speed - 0.90) / 0.10, 0.0, 1.0), 2.0) * (2.0 - math.clamp((query.modified_move_speed - 0.90) / 0.10, 0.0, 1.0)) + math.max(query.modified_move_speed - 1.0, 0.0)) / math.max(query.modified_move_speed, 0.12), 0.95, 3.2) : 1.0)) * -1.4",
            -0.1,
            -0.1
          ]
        },
        "rightleg": {
          "rotation": [
            "(variable.tcos0 * ((query.is_sprinting && !query.is_in_water && !query.is_swimming && !query.is_riding && !query.is_gliding && !variable.is_paperdoll) ? math.clamp((0.90 + 0.10 * math.pow(math.clamp((query.modified_move_speed - 0.90) / 0.10, 0.0, 1.0), 2.0) * (2.0 - math.clamp((query.modified_move_speed - 0.90) / 0.10, 0.0, 1.0)) + math.max(query.modified_move_speed - 1.0, 0.0)) / math.max(query.modified_move_speed, 0.12), 0.95, 3.2) : 1.0)) * 1.4",
            0.1,
            0.1
          ]
        }
      }
    }
  }
}
