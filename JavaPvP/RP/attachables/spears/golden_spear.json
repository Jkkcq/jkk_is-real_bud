{
  "format_version": "1.12.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "bf:golden_spear",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/spear/gold_spear",
        "enchanted": "textures/misc/enchanted_item_glint",
        "offhand_icon": "textures/items/golden_spear"
      },
      "geometry": {
        "default": "geometry.spear",
        "offhand": "geometry.item_first_person_offhand_icon"
      },
      "animations": {
        "held_first_person": "animation.spear.held_first_person",
        "held_third_person": "animation.spear.held_third_person",
        "hit": "animation.spear.hit",
        "ctrl_held": "controller.animation.spear.held",
        "ctrl_hit": "controller.animation.spear.hit",
        "offhand": "animation.bow_offhand.wield"
      },
      "scripts": {
        "animate": [
          "ctrl_held",
          "ctrl_hit",
          {
            "offhand": "c.is_first_person && query.is_item_name_any('slot.weapon.offhand', 0, 'bf:golden_spear')"
          }
        ]
      },
      "sound_effects": {
        "hit": "item.spear.attack_hit"
      },
      "render_controllers": [
        {
          "controller.render.item_default": "!(c.is_first_person && query.is_item_name_any('slot.weapon.offhand', 0, 'bf:golden_spear'))"
        },
        {
          "controller.render.item_offhand_icon": "c.is_first_person && query.is_item_name_any('slot.weapon.offhand', 0, 'bf:golden_spear')"
        }
      ]
    }
  }
}