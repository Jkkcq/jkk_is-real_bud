{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "minecraft:mace",
			"render_controllers": [
				{
					"controller.render.item_default": "!(c.is_first_person && query.is_item_name_any('slot.weapon.offhand', 0, 'minecraft:mace'))"
				},
				{
					"controller.render.item_offhand_icon": "c.is_first_person && query.is_item_name_any('slot.weapon.offhand', 0, 'minecraft:mace')"
				}
			],
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/mace",
				"enchanted": "textures/misc/enchanted_item_glint",
				"offhand_icon": "textures/items/mace"
			},
			"geometry": {
				"default": "geometry.item_first_person",
				"offhand": "geometry.item_first_person_offhand_icon"
			},
			"animations": {
				"first_person_hold": "animation.mace.first_person_hold",
				"third_person_hold": "animation.mace.third_person_hold",
				"offhand": "animation.bow_offhand.wield"
			},
			"scripts": {
				"animate": [
					{
						"first_person_hold": "c.is_first_person"
					},
					{
						"third_person_hold": "!c.is_first_person"
					},
					{
						"offhand": "c.is_first_person && query.is_item_name_any('slot.weapon.offhand', 0, 'minecraft:mace')"
					}
				]
			}
		}
	}
}